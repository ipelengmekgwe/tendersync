# Settings for running the hosts with `dotnet run` (put them in dotnet user-secrets or a git-ignored .env). The Docker
# Compose stack has its own list in deploy/docker/.env.example (runbook: docs/runbooks/local.md).

# PostgreSQL (Compose)
POSTGRES_DB=tendersync
POSTGRES_USER=tendersync
POSTGRES_PASSWORD=tendersync
POSTGRES_PORT=5432

# Seq (Compose)
SEQ_PORT=5341
SEQ_NO_AUTH=True

# Application secrets (prefer `dotnet user-secrets` locally; Key Vault on Azure). Used from WP02 onwards.
ConnectionStrings__TenderSync=Host=localhost;Port=5432;Database=tendersync;Username=tendersync;Password=tendersync
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=change-me-minimum-12-chars
Seed__AdminDisplayName=Administrator
Jwt__SigningKey=change-me-to-a-64-char-random-string
# Company-document encryption (WP09, ADR-013): one or more base64 32-byte keys by id, the active id, or just TENDERSYNC_MASTER_KEY (read as id "env").
# Generate with: openssl rand -base64 32. Rotation: docs/runbooks/key-rotation.md. On Azure: Encryption__Provider=KeyVault + Encryption__KeyVault__KeyUri.
TENDERSYNC_MASTER_KEY=base64-encoded-32-byte-key-for-document-encryption
Encryption__Provider=Environment
Encryption__ActiveKeyId=
Encryption__Keys__k1=
Encryption__KeyVault__KeyUri=
# Document store (WP04): FileSystem (default; empty RootPath = %LOCALAPPDATA%/TenderSync/documents) or AzureBlob
DocumentStore__Provider=FileSystem
DocumentStore__FileSystem__RootPath=
# AzureBlob signs in with a connection string (Azurite) or, on Azure, with managed identity through ServiceUri (https://{account}.blob.core.windows.net)
DocumentStore__AzureBlob__ConnectionString=
DocumentStore__AzureBlob__ServiceUri=
DocumentStore__AzureBlob__ContainerName=documents
# LLM (WP06): routing per purpose (Llm__Routing__classify=anthropic|openai|fake), daily cap, provider settings
Llm__DefaultProvider=anthropic
Llm__DailyCostCapUsd=10
Llm__Anthropic__ApiKey=
Llm__Anthropic__FastModel=claude-haiku-5-5
Llm__Anthropic__StrongModel=claude-opus-5-5
Llm__OpenAiCompatible__BaseUrl=
Llm__OpenAiCompatible__ApiKey=
Llm__OpenAiCompatible__FastModel=
Llm__OpenAiCompatible__StrongModel=
# Notifications (WP10): channel credentials; recipients come from each user's preferences (PUT /api/v1/notification-preferences)
Notifications__DashboardBaseUrl=http://localhost:3000
Notifications__Email__SmtpHost=
Notifications__Email__SmtpPort=587
Notifications__Email__SmtpUser=
Notifications__Email__SmtpPassword=
Notifications__Email__FromAddress=
Notifications__Email__FromName=TenderSync
Notifications__Telegram__BotToken=
Notifications__Telegram__ChatId=
Notifications__Teams__WebhookUrl=
Notifications__Sms__Provider=NoOp
Notifications__Sms__ApiKey=
