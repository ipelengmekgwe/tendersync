    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="ExcelDataReader" Version="3.9.0" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label="Hosts">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
