# Docker Compose settings for deploy/docker. Copy to deploy/docker/.env (git-ignored), or run
#   deploy/docker/tendersync.ps1 init      (PowerShell)   /   deploy/docker/tendersync.sh init   (bash)
# which writes one with random secrets. Every line here is also passed into the api, worker and migrate containers,
# so any app setting can be added under its own name (Section__Key), e.g. Llm__Anthropic__ApiKey.

# Images and ports (published on BIND_ADDRESS; 127.0.0.1 keeps the stack on this machine)
TENDERSYNC_TAG=local
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=5000
WORKER_PORT=5001
SEQ_PORT=5341
POSTGRES_PORT=5432
# Address people use for the dashboard: links in notifications and the API's CORS origin
PUBLIC_WEB_URL=http://localhost:3000
# true only behind HTTPS (the auth cookies become Secure)
AUTH_COOKIE_SECURE=false

# PostgreSQL
POSTGRES_DB=tendersync
POSTGRES_USER=tendersync
POSTGRES_PASSWORD=tendersync

# Seq log viewer (local only)
SEQ_NO_AUTH=True

# Production by default; the override file switches to Development (DevAuth: any credentials sign in as Admin)
ASPNETCORE_ENVIRONMENT=
# Secrets: required for the production-like stack (docker compose -f docker-compose.yml ...)
Jwt__SigningKey=
Seed__AdminEmail=
Seed__AdminPassword=
# base64 32-byte key for company-document encryption (openssl rand -base64 32); keep it safe, documents need it
TENDERSYNC_MASTER_KEY=

# Recurring job the Worker runs once when it starts (empty: wait for the schedule)
WORKER_TRIGGER_ON_START=ingest-recent-releases

# Optional providers and channels
Llm__Anthropic__ApiKey=
Notifications__Email__SmtpHost=
Notifications__Email__SmtpPort=587
Notifications__Email__SmtpUser=
Notifications__Email__SmtpPassword=
Notifications__Email__FromAddress=
Notifications__Telegram__BotToken=
Notifications__Teams__WebhookUrl=
