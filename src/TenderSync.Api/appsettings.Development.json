{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "DevAuth": {
    "AllowAnyCredentials": true
  }
}
