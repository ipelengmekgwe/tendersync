{
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "DevAuth": {
    "AllowAnyCredentials": true
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 200,
      "WindowSeconds": 60
    }
  }
}
