{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TenderSync": "Host=localhost;Port=5432;Database=tendersync;Username=tendersync;Password=tendersync"
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Jwt": {
    "Issuer": "TenderSync",
    "Audience": "TenderSync",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminDisplayName": "Administrator"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "DocumentStore": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootPath": ""
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "documents"
    }
  },
  "Llm": {
    "DefaultProvider": "anthropic",
    "DailyCostCapUsd": 10,
    "AllowCompanyDocuments": true,
    "RecordingPath": "",
    "Routing": {},
    "Anthropic": {
      "ApiKey": "",
      "BaseUrl": "",
      "FastModel": "claude-haiku-5-5",
      "StrongModel": "claude-opus-5-5",
      "Fallbacks": "default",
      "Betas": [],
      "MaxRetries": 2,
      "TimeoutSeconds": 300,
      "CacheSystemPrompt": true
    },
    "OpenAiCompatible": {
      "BaseUrl": "",
      "ApiKey": "",
      "FastModel": "",
      "StrongModel": "",
      "UseJsonSchema": true,
      "TimeoutSeconds": 300
    },
    "Pricing": {}
  }
}
