TenderSync digest for {{ Date }}
<div style="font-family:Segoe UI,Arial,sans-serif;font-size:15px;color:#1f2933;max-width:640px">
<p style="margin:0 0 4px;color:#52606d;font-size:13px">TenderSync · {{ Type }}</p>
<p style="margin:0">{{ NewMatches.size }} new match(es), {{ ClosingSoon.size }} closing soon, {{ Qualified.size }} qualification report(s).</p>
{{ if NewMatches.size > 0 }}<h3 style="margin:16px 0 4px;font-size:15px">New matches (24 h)</h3><ul style="margin:0;padding-left:20px">{{ for item in NewMatches }}<li><a href="{{ item.TenderUrl | html.escape }}">{{ item.BidNumber | html.escape }}</a> {{ item.Title | html.escape }} — {{ item.Buyer | html.escape }}, closing {{ item.Closing }}{{ if item.Relevance }}, relevance {{ item.Relevance }}{{ end }}, {{ item.Verdict | html.escape }}</li>{{ end }}</ul>{{ end }}
{{ if ClosingSoon.size > 0 }}<h3 style="margin:16px 0 4px;font-size:15px">Closing soon</h3><ul style="margin:0;padding-left:20px">{{ for item in ClosingSoon }}<li><a href="{{ item.TenderUrl | html.escape }}">{{ item.BidNumber | html.escape }}</a> {{ item.Title | html.escape }} — {{ item.Buyer | html.escape }}, closing {{ item.Closing }}{{ if item.Relevance }}, relevance {{ item.Relevance }}{{ end }}, {{ item.Verdict | html.escape }}</li>{{ end }}</ul>{{ end }}
{{ if Qualified.size > 0 }}<h3 style="margin:16px 0 4px;font-size:15px">Qualification reports (24 h)</h3><ul style="margin:0;padding-left:20px">{{ for item in Qualified }}<li><a href="{{ item.TenderUrl | html.escape }}">{{ item.BidNumber | html.escape }}</a> {{ item.Title | html.escape }} — {{ item.Buyer | html.escape }}, closing {{ item.Closing }}{{ if item.Relevance }}, relevance {{ item.Relevance }}{{ end }}, {{ item.Verdict | html.escape }}</li>{{ end }}</ul>{{ end }}
{{ if NewMatches.size == 0 && ClosingSoon.size == 0 && Qualified.size == 0 }}<p style="margin:12px 0 0">Nothing new since yesterday.</p>{{ end }}
<p style="margin:16px 0 0"><a href="{{ DashboardUrl | html.escape }}" style="color:#1d4ed8">Open TenderSync</a></p>
<p style="margin:20px 0 0;color:#7b8794;font-size:12px">Generated automatically from the eTenders portal and your company profile. Verify against the source documents before acting.</p>
</div>
