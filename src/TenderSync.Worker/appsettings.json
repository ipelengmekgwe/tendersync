{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TenderSync": "Host=localhost;Port=5432;Database=tendersync;Username=tendersync;Password=tendersync"
  },
  "Jwt": {
    "Issuer": "TenderSync",
    "Audience": "TenderSync",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Hangfire": {
    "ServerEnabled": true,
    "WorkerCount": 4,
    "QueuePollSeconds": 5,
    "PipelineWorkerCount": 2
  },
  "DocumentStore": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootPath": ""
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "documents"
    }
  },
  "Documents": {
    "MaxDocumentBytes": 52428800,
    "MaxConcurrentDownloads": 2,
    "DownloadSpacingMs": 500,
    "DownloadTimeoutSeconds": 300,
    "OcrMinCharsPerPage": 50,
    "ZipMaxDepth": 2
  }
}
