{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TenderSync": "Host=localhost;Port=5432;Database=tendersync;Username=tendersync;Password=tendersync"
  },
  "Jwt": {
    "Issuer": "TenderSync",
    "Audience": "TenderSync",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Hangfire": {
    "ServerEnabled": true,
    "WorkerCount": 4,
    "QueuePollSeconds": 5,
    "PipelineWorkerCount": 2
  },
  "DocumentStore": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootPath": ""
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "documents"
    }
  },
  "Documents": {
    "MaxDocumentBytes": 52428800,
    "MaxConcurrentDownloads": 2,
    "DownloadSpacingMs": 500,
    "DownloadTimeoutSeconds": 300,
    "OcrMinCharsPerPage": 50,
    "ZipMaxDepth": 2
  },
  "Llm": {
    "DefaultProvider": "anthropic",
    "DailyCostCapUsd": 10,
    "AllowCompanyDocuments": true,
    "RecordingPath": "",
    "Routing": {},
    "Anthropic": {
      "ApiKey": "",
      "BaseUrl": "",
      "FastModel": "claude-haiku-5-5",
      "StrongModel": "claude-opus-5-5",
      "Fallbacks": "default",
      "Betas": [],
      "MaxRetries": 2,
      "TimeoutSeconds": 300,
      "CacheSystemPrompt": true
    },
    "OpenAiCompatible": {
      "BaseUrl": "",
      "ApiKey": "",
      "FastModel": "",
      "StrongModel": "",
      "UseJsonSchema": true,
      "TimeoutSeconds": 300
    },
    "Pricing": {}
  },
  "Classification": {
    "TitleWeight": 3,
    "DescriptionWeight": 1,
    "DocumentTitleWeight": 2,
    "NegativeWeight": 2,
    "CandidateMinScore": 1,
    "MatchThreshold": 60,
    "NearMissThreshold": 40,
    "MinCategoryConfidence": 0.4
  },
  "Extraction": {
    "PreferNativePdf": true,
    "MaxNativePdfBytes": 33554432,
    "MaxNativePdfPages": 600,
    "MaxDocumentsPerTender": 8,
    "MaxOutputTokens": 8192,
    "Tier": "Strong",
    "Effort": "Medium",
    "WarnCostPerTenderUsd": 1
  }
}
