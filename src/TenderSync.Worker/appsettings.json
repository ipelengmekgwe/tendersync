{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TenderSync": "Host=localhost;Port=5432;Database=tendersync;Username=tendersync;Password=tendersync"
  },
  "Jwt": {
    "Issuer": "TenderSync",
    "Audience": "TenderSync",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Hangfire": {
    "ServerEnabled": true,
    "WorkerCount": 4,
    "QueuePollSeconds": 5,
    "PipelineWorkerCount": 2
  },
  "DocumentStore": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootPath": ""
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ServiceUri": "",
      "ContainerName": "documents"
    }
  },
  "Documents": {
    "MaxDocumentBytes": 52428800,
    "MaxConcurrentDownloads": 2,
    "DownloadSpacingMs": 500,
    "DownloadTimeoutSeconds": 300,
    "OcrMinCharsPerPage": 50,
    "ZipMaxDepth": 2
  },
  "Llm": {
    "DefaultProvider": "anthropic",
    "DailyCostCapUsd": 10,
    "AllowCompanyDocuments": true,
    "RecordingPath": "",
    "Routing": {},
    "Anthropic": {
      "ApiKey": "",
      "BaseUrl": "",
      "FastModel": "claude-haiku-5-5",
      "StrongModel": "claude-opus-5-5",
      "Fallbacks": "default",
      "Betas": [],
      "MaxRetries": 2,
      "TimeoutSeconds": 300,
      "CacheSystemPrompt": true
    },
    "OpenAiCompatible": {
      "BaseUrl": "",
      "ApiKey": "",
      "FastModel": "",
      "StrongModel": "",
      "UseJsonSchema": true,
      "TimeoutSeconds": 300
    },
    "Pricing": {}
  },
  "Classification": {
    "TitleWeight": 3,
    "DescriptionWeight": 1,
    "DocumentTitleWeight": 2,
    "NegativeWeight": 2,
    "CandidateMinScore": 1,
    "MatchThreshold": 60,
    "NearMissThreshold": 40,
    "MinCategoryConfidence": 0.4
  },
  "Extraction": {
    "PreferNativePdf": true,
    "MaxNativePdfBytes": 33554432,
    "MaxNativePdfPages": 600,
    "MaxDocumentsPerTender": 8,
    "MaxOutputTokens": 8192,
    "Tier": "Strong",
    "Effort": "Medium",
    "WarnCostPerTenderUsd": 1
  },
  "Encryption": {
    "Provider": "Environment",
    "ActiveKeyId": "",
    "Keys": {},
    "KeyVault": {
      "KeyUri": ""
    },
    "ChunkSize": 65536
  },
  "CompanyDocuments": {
    "MaxBytes": 26214400
  },
  "Qualification": {
    "MandatoryWeight": 60,
    "FunctionalityWeight": 30,
    "DocumentsWeight": 10,
    "FuzzyMatchMinConfidence": 0.7,
    "EstimateTier": "Strong",
    "EstimateEffort": "Medium",
    "EstimateMaxOutputTokens": 6000,
    "FuzzyMaxOutputTokens": 2048,
    "MaxReferenceProjects": 15
  },
  "Notifications": {
    "DashboardBaseUrl": "http://localhost:3000",
    "UrgentClosingDays": 2,
    "SweepOlderThanSeconds": 30,
    "SweepBatchSize": 50,
    "DigestClosingDays": 7,
    "MaxMissingItems": 3,
    "Email": {
      "SmtpHost": "",
      "SmtpPort": 587,
      "SmtpUser": "",
      "SmtpPassword": "",
      "FromAddress": "",
      "FromName": "TenderSync",
      "Security": "StartTls",
      "TimeoutSeconds": 30
    },
    "Telegram": {
      "BotToken": "",
      "BaseUrl": "https://api.telegram.org",
      "ChatId": ""
    },
    "Teams": {
      "WebhookUrl": ""
    },
    "Sms": {
      "Provider": "NoOp",
      "ApiKey": "",
      "BaseUrl": "https://platform.clickatell.com",
      "From": ""
    },
    "WhatsApp": {
      "Provider": "NoOp"
    }
  },
  "Status": {
    "RefreshLookbackDays": 7,
    "RefreshMaxTenders": 500,
    "RefreshSpacingMs": 250,
    "ClosingSoonDays": 7,
    "BriefingReminderDays": 2,
    "DocumentExpiryDays": 30,
    "ComputeBatchSize": 500
  }
}
