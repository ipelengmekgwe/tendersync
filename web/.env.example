# Copy to .env.local (git-ignored). The browser never sees these: only the Next.js server reads them.
# Base URL of TenderSync.Api
API_BASE_URL=http://localhost:5000
# Mark auth cookies Secure (HTTPS only). Defaults to true in production builds, false in development.
AUTH_COOKIE_SECURE=false
# Playwright e2e (npm run test:e2e): the seeded admin from the API's user-secrets
E2E_BASE_URL=http://localhost:3000
E2E_EMAIL=
E2E_PASSWORD=
# true when the API runs with DevAuth:AllowAnyCredentials (its Development default): skips the wrong-password check
E2E_DEV_AUTH_BYPASS=true
# The global setup seeds the demo tenders (dotnet run ... --seed-demo) before each run; true skips it
E2E_SKIP_SEED=false
# true when the API answers classification with a fake (Llm__Routing__classify=fake + Llm__FakeAnswers__classify): runs the category spec
E2E_FAKE_CLASSIFY=false
# Password the role-gating spec gives the e2e-viewer@tendersync.local account it creates
E2E_VIEWER_PASSWORD=
